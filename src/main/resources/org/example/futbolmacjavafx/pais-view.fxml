<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.futbolmacjavafx.control.PaisController"
            prefHeight="400.0" prefWidth="600.0">

    <children>
        <Label layoutX="25.0" layoutY="20.0" styleClass="h4, text-primary" text="Mantenimiento de Países" />

        <!-- Formulario -->
        <HBox layoutX="25.0" layoutY="65.0" spacing="15.0" alignment="CENTER_LEFT">
            <children>
                <Label text="Nombre:" prefWidth="70.0" />
                <TextField fx:id="txtNombrePais" prefWidth="300.0" styleClass="form-control" />
            </children>
        </HBox>

        <!-- Botones -->
        <HBox layoutX="25.0" layoutY="115.0" spacing="10.0">
            <children>
                <Button fx:id="btnGuardar" text="Añadir" onAction="#guardar" styleClass="btn, btn-primary" />
                <Button fx:id="btnModificar" text="Actualizar" onAction="#modificar" styleClass="btn, btn-warning" />
                <Button fx:id="btnEliminar" text="Eliminar" onAction="#eliminar" styleClass="btn, btn-danger" />
                <Button fx:id="btnLimpiar" text="Limpiar" onAction="#limpiarFormulario" styleClass="btn, btn-secondary" />
            </children>
        </HBox>

        <!-- Tabla -->
        <TableView fx:id="tablaPais" layoutX="25.0" layoutY="170.0" prefHeight="350.0" prefWidth="500.0"
                   onMouseClicked="#seleccionarFila" style="-fx-box-border: transparent;">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colIdPais" prefWidth="80.0" text="ID" />
                <TableColumn fx:id="colNombrePais" prefWidth="420.0" text="País" />
            </columns>
        </TableView>
    </children>
</AnchorPane>
