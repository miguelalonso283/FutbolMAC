<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="600.0" prefWidth="950.0"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.futbolmacjavafx.control.MenuController">

    <left>
        <VBox prefWidth="220.0" spacing="12.0" style="-fx-background-color: #212529; -fx-padding: 20;">
            <children>
                <!-- Clases de Bootstrap: btn, btn-outline-light, btn-block -->
                <Button fx:id="btnEquipos" maxWidth="Infinity" text="Equipos" onAction="#mostrarEquipos" styleClass="btn, btn-outline-light" />
                <Button fx:id="btnJugadores" maxWidth="Infinity" text="👤 Jugadores"  styleClass="btn, btn-outline-light" />

                <VBox VBox.vgrow="ALWAYS" /> <!-- Espaciador dinámico -->

                <!-- Botón de acción principal usando btn-danger (Rojo Bootstrap)  onAction="#generarReporte"-->
                <Button fx:id="btnReportes" maxWidth="Infinity" text="📊 Reporte Jasper"  styleClass="btn, btn-danger" />
            </children>
        </VBox>
    </left>

    <center>
        <AnchorPane fx:id="contentArea" prefHeight="600.0" prefWidth="730.0" style="-fx-background-color: #f8f9fa;" />
    </center>
</BorderPane>
