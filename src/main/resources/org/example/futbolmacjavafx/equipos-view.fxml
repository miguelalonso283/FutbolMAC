<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.futbolmacjavafx.control.EquipoController"
            prefHeight="400.0" prefWidth="600.0">

    <children>
        <!-- Título principal con estilo Bootstrap -->
        <Label layoutX="25.0" layoutY="20.0" styleClass="h4, text-primary" text="Mantenimiento de Equipos" />

        <!-- Contenedor del Formulario -->
        <VBox layoutX="25.0" layoutY="65.0" spacing="10.0" prefWidth="450.0">
            <children>
                <HBox spacing="15.0" alignment="CENTER_LEFT">
                    <children>
                        <Label text="Nombre:" prefWidth="70.0" />
                        <TextField fx:id="txtNombreEquipo" HBox.hgrow="ALWAYS" styleClass="form-control"  />
                        <TextField fx:id="txtSiglas" />
                        <TextField fx:id="txtCiudad" />
                        <TextField fx:id="txtEstadio" />
                        <TextField fx:id="txtLiga" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- Fila de Botones con Clases de Bootstrap -->
        <HBox layoutX="25.0" layoutY="165.0" spacing="10.0">
            <children>
                <Button fx:id="btnGuardar" text="Añadir" onAction="#guardar" styleClass="btn, btn-primary" />
                <Button fx:id="btnModificar" text="Actualizar" onAction="#modificar" styleClass="btn, btn-warning" />
                <Button fx:id="btnEliminar" text="Eliminar" onAction="#eliminar" styleClass="btn, btn-danger" />
                <Button fx:id="btnLimpiar" text="Limpiar" onAction="#limpiarFormulario" styleClass="btn, btn-secondary" />
            </children>
        </HBox>

        <!-- Tabla de Datos Integrada -->
        <TableView fx:id="tablaEquipo" layoutX="25.0" layoutY="225.0" prefHeight="300.0" prefWidth="660.0" onMouseClicked="#seleccionarFila" style="-fx-box-border: transparent;">
            <columns>
                <TableColumn fx:id="colIdEquipo" prefWidth="70.0" text="ID" />
                <TableColumn fx:id="colNombreEquipo" prefWidth="280.0" text="Nombre del Equipo" />
                <TableColumn fx:id="colSiglas" prefWidth="280.0" text="Siglas del Equipo" />
                <TableColumn fx:id="colCiudad" prefWidth="280.0" text="Ciudad del Equipo" />
                <TableColumn fx:id="colEstadio" prefWidth="280.0" text="Estadio del Equipo" />
                <TableColumn fx:id="colLiga" prefWidth="310.0" text="Liga en la que participa" />
            </columns>
        </TableView>
    </children>
</AnchorPane>
